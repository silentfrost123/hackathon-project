# Copy this file to .env and paste your free Gemini key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: which Gemini model to use
GEMINI_MODEL=gemini-3.8-flash
# Optional: backups tried in order when the main model is busy
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-flash-latest

# --- Accounts + KYC (see KYC.md) ---
# Secret used to HMAC ID numbers. At least 32 random characters; keep it stable.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JISR_ID_PEPPER=
# KYC adapter that sends codes and checks IDs. Only "mock" exists in the prototype.
KYC_PROVIDER=mock
# Fixed one-time code used by the mock provider (shown in the UI's demo-mode hint).
DEMO_OTP_CODE=123456
# Optional: where the SQLite database lives (default ./.data/jisr.db). Use a persistent volume when hosted.
# JISR_DATA_DIR=./.data
# Set to 1 behind a proxy (Railway, Render, nginx): real client IP for rate limits + Secure cookie on HTTPS.
# TRUST_PROXY=1
