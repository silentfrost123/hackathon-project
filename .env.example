# Copy this file to .env and paste your free Gemini key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: which Gemini model to use
GEMINI_MODEL=gemini-3.8-flash
# Optional: backups tried in order when the main model is busy
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-flash-latest
